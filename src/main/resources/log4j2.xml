<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="error">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%-5p %c{1}:%L - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="console"/>
        </Root>
        <Logger name="app.krista.extensions.essentials.documents.splitpdf" level="debug" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="app.krista" level="info" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="org.apache.pdfbox" level="warn"/>
        <Logger name="org.apache.fontbox" level="warn"/>
    </Loggers>
</Configuration>
